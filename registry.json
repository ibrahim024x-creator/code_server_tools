          {
            "executables": ["ccls"],
            "vscodeExtension": "ccls-project.ccls",
            "settings": {
              "ccls.launch.command": "{path}"
            }
          },
          {
            "executables": ["cpptools", "cpp-tools"],
            "vscodeExtension": "ms-vscode.cpptools",
            "settings": {
              "C_Cpp.default.cppIntelliSenseEngine": "default"
