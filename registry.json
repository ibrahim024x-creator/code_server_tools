    "rust": {
      "extensions": [".rs"],
      "filetypes": ["rust"],
      "languageId": ["rust"],
      "tools": {
        "lsp": [
          {
            "executables": ["rust-analyzer", "rust_analyzer"],
            "vscodeExtension": "rust-lang.rust-analyzer",
            "settings": {
              "rust-analyzer.server.path": "{path}"
            }
          }
        ],
        "dap": [
          {
            "executables": ["codelldb", "rust-lldb"],
            "vscodeExtension": "vadimcn.vscode-lldb",
            "adapter": "lldb",
            "launchConfig": {
              "name": "Rust: Debug",
              "type": "lldb",
              "request": "launch",
              "program": "${workspaceFolder}/target/debug/${workspaceFolderBasename}",
              "cwd": "${workspaceFolder}"
            }
          }
        ],
        "formatter": [
          {
            "executables": ["rustfmt"],
            "vscodeExtension": "rust-lang.rust-analyzer",
            "settings": {
              "rust-analyzer.rustfmt.path": "{path}"
            }
          }
        ],
        "linter": [
          {
            "executables": ["clippy", "cargo-clippy"],
            "vscodeExtension": "rust-lang.rust-analyzer",
            "settings": {
              "rust-analyzer.check.command": "clippy"
            }
          }
        ],
        "compiler": [
          {
            "executables": ["cargo", "rustc"],
            "vscodeExtension": "rust-lang.rust-analyzer",
            "settings": {}
          }
        ]
      }
    },

    "c_cpp": {
      "extensions": [".c", ".cpp", ".cc", ".cxx", ".h", ".hpp", ".hh"],
      "filetypes": ["c", "cpp"],
      "languageId": ["c", "cpp"],
      "tools": {
        "lsp": [
          {
            "executables": ["clangd"],
            "vscodeExtension": "llvm-vs-code-extensions.vscode-clangd",
            "settings": {
              "clangd.path": "{path}",
              "C_Cpp.intellisenseEngine": "disabled"
            }
          },
          {
            "executables": ["ccls"],
            "vscodeExtension": "ccls-project.ccls",
            "settings": {
              "ccls.launch.command": "{path}",
              "C_Cpp.intellisenseEngine": "disabled"
            }
          }
        ],
        "dap": [
          {
            "executables": ["gdb"],
            "vscodeExtension": "ms-vscode.cpptools",
            "adapter": "cppdbg",
            "launchConfig": {
              "name": "C/C++: GDB",
              "type": "cppdbg",
              "request": "launch",
              "program": "${workspaceFolder}/a.out",
              "args": [],
              "cwd": "${workspaceFolder}",
              "MIMode": "gdb",
              "miDebuggerPath": "{path}",
              "setupCommands": [
                {
                  "description": "Enable pretty-printing for gdb",
                  "text": "-enable-pretty-printing",
                  "ignoreFailures": true
                }
              ]
            }
          },
          {
            "executables": ["codelldb", "lldb"],
            "vscodeExtension": "vadimcn.vscode-lldb",
            "adapter": "lldb",
            "launchConfig": {
              "name": "C/C++: LLDB",
              "type": "lldb",
              "request": "launch",
              "program": "${workspaceFolder}/a.out",
              "args": [],
              "cwd": "${workspaceFolder}"
            }
          }
        ],
        "formatter": [
          {
            "executables": ["clang-format"],
            "vscodeExtension": "xaver.clang-format",
            "settings": {
              "C_Cpp.formatting": "clangFormat",
              "clang-format.executable": "{path}"
            }
          }
        ],
        "linter": [
          {
            "executables": ["clang-tidy"],
            "vscodeExtension": "notskm.clang-tidy",
            "settings": {
              "clang-tidy.executable": "{path}"
            }
          },
          {
            "executables": ["cppcheck"],
            "vscodeExtension": "MS-CEINTUL.vscode-cppcheck",
            "settings": {
              "cppcheck.executable": "{path}"
            }
          }
        ],
        "compiler": [
          {
            "executables": ["gcc", "g++", "cc", "c++"],
            "vscodeExtension": "ms-vscode.cpptools",
            "settings": {}
          },
          {
            "executables": ["clang", "clang++"],
            "vscodeExtension": "ms-vscode.cpptools",
            "settings": {}
          }
        ]
      }
    },

