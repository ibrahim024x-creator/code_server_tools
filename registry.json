{
  "$schema": "tool discovery registry — maps executable names to language, role, and vscode settings",
  "languages": {
    "python": {
      "extensions": [".py", ".pyi", ".pyw"],
      "filetypes": ["python"],
      "languageId": "python",
      "tools": {
        "lsp": [
          {
            "executables": ["pylsp", "python-lsp-server"],
            "vscodeExtension": "ms-python.python",
            "settings": {
              "python.languageServer": "Pylsp"
            }
          },
          {
            "executables": ["pyright", "pyright-langserver"],
            "vscodeExtension": "ms-python.python",
            "settings": {
              "python.languageServer": "Pylance"
            }
          },
          {
            "executables": ["jedi-language-server"],
            "vscodeExtension": "ms-python.python",
            "settings": {
              "python.languageServer": "Jedi"
            }
          },
          {
            "executables": ["ruff", "ruff-lsp"],
            "vscodeExtension": "charliermarsh.ruff",
            "settings": {
              "python.languageServer": "Ruff"
            }
          }
        ],
        "dap": [
          {
            "executables": ["debugpy", "python-debugpy"],
            "vscodeExtension": "ms-python.python",
            "adapter": "python"
          }
        ],
        "formatter": [
          {
            "executables": ["black"],
            "vscodeExtension": "ms-python.black-formatter",
            "settings": {
              "python.formatting.provider": "black"
            }
          },
          {
            "executables": ["ruff"],
            "vscodeExtension": "charliermarsh.ruff",
            "settings": {
              "python.formatting.provider": "ruff"
            }
          },
          {
            "executables": ["autopep8"],
            "vscodeExtension": "ms-python.autopep8",
            "settings": {
              "python.formatting.provider": "autopep8"
            }
          },
          {
            "executables": ["yapf"],
            "vscodeExtension": "ms-python.python",
            "settings": {
              "python.formatting.provider": "yapf"
            }
          }
        ],
        "linter": [
          {
            "executables": ["ruff"],
            "vscodeExtension": "charliermarsh.ruff",
            "settings": {
              "python.linting.ruffEnabled": true
            }
          },
          {
            "executables": ["flake8"],
            "vscodeExtension": "ms-python.flake8",
            "settings": {
              "python.linting.flake8Enabled": true
            }
          },
          {
            "executables": ["pylint"],
            "vscodeExtension": "ms-python.pylint",
            "settings": {
              "python.linting.pylintEnabled": true
            }
          },
          {
            "executables": ["mypy"],
            "vscodeExtension": "ms-python.mypy-type-checker",
            "settings": {
              "python.linting.mypyEnabled": true
            }
          }
        ],
        "treeSitter": [],
        "compiler": [
          {
            "executables": ["python3", "python"],
            "vscodeExtension": "ms-python.python",
            "settings": {
              "python.defaultInterpreterPath": "{path}"
            }
          }
        ]
      }
    },

    "javascript_typescript": {
      "extensions": [".js", ".jsx", ".ts", ".tsx", ".mjs", ".cjs"],
      "filetypes": ["javascript", "typescript", "javascriptreact", "typescriptreact"],
      "languageId": "typescript",
      "tools": {
        "lsp": [
          {
            "executables": ["typescript-language-server", "ts-language-server"],
            "vscodeExtension": "ms-vscode.vscode-typescript-next",
            "settings": {
              "typescript.tsserver.path": "{path}"
            }
          },
          {
            "executables": ["vtsls"],
            "vscodeExtension": "vscodevim.vim",
            "settings": {}
          }
        ],
        "dap": [
          {
            "executables": ["node"],
            "vscodeExtension": "ms-vscode.js-debug",
            "adapter": "node"
          }
        ],
        "formatter": [
          {
            "executables": ["prettier"],
            "vscodeExtension": "esbenp.prettier-vscode",
            "settings": {
              "editor.defaultFormatter": "esbenp.prettier-vscode",
              "prettier.prettierPath": "{path}"
            }
          },
          {
            "executables": ["biome", "biome-format"],
            "vscodeExtension": "biomejs.biome",
            "settings": {
              "editor.defaultFormatter": "biomejs.biome"
            }
          },
          {
            "executables": ["deno"],
            "vscodeExtension": "denoland.vscode-deno",
            "settings": {
              "deno.enable": true
            }
          }
        ],
        "linter": [
          {
            "executables": ["eslint", "eslint_d"],
            "vscodeExtension": "dbaeumer.vscode-eslint",
            "settings": {
              "eslint.enable": true,
              "eslint.execArgv": []
            }
          },
          {
            "executables": ["biome"],
            "vscodeExtension": "biomejs.biome",
            "settings": {}
          },
          {
            "executables": ["oxlint"],
            "vscodeExtension": "oxc.oxc-vscode",
            "settings": {}
          }
        ],
        "treeSitter": [],
        "compiler": [
          {
            "executables": ["tsc", "typescript"],
            "vscodeExtension": "ms-vscode.vscode-typescript-next",
            "settings": {}
          },
          {
            "executables": ["node", "nodejs"],
            "vscodeExtension": "ms-vscode.node-extension-pack",
            "settings": {}
          },
          {
            "executables": ["deno"],
            "vscodeExtension": "denoland.vscode-deno",
            "settings": {}
          },
          {
            "executables": ["bun"],
            "vscodeExtension": "oven.bun-vscode",
            "settings": {}
          }
        ]
      }
    },

    "go": {
