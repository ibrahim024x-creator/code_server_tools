{
  "_description": "Tool discovery registry — maps executable names to language, role, VS Code extension, and settings. Used by devtools-bridge.py.",
  "languages": {
    "python": {
      "extensions": [".py", ".pyi", ".pyw"],
      "filetypes": ["python"],
      "languageId": ["python"],
      "tools": {
        "lsp": [
          {
            "executables": ["pylsp"],
            "vscodeExtension": "ms-python.python",
            "settings": {
              "python.languageServer": "Pylsp"
            }
          },
          {
            "executables": ["pyright", "pyright-langserver"],
            "vscodeExtension": "ms-pyright.pyright",
            "settings": {}
          },
          {
            "executables": ["jedi-language-server"],
            "vscodeExtension": "ms-python.python",
            "settings": {
              "python.languageServer": "Jedi"
            }
          }
        ],
        "dap": [
          {
            "executables": ["debugpy"],
            "vscodeExtension": "ms-python.python",
            "adapter": "python",
            "launchConfig": {
              "name": "Python: Current File",
              "type": "python",
              "request": "launch",
              "program": "${file}",
              "console": "integratedTerminal",
              "justMyCode": true
            }
          }
        ],
        "formatter": [
          {
            "executables": ["ruff"],
            "vscodeExtension": "charliermarsh.ruff",
            "settings": {
              "[python]": {
                "editor.defaultFormatter": "charliermarsh.ruff"
              },
              "ruff.path": ["{path}"]
            }
          },
          {
            "executables": ["black"],
            "vscodeExtension": "ms-python.vscode-black-formatter",
            "settings": {
              "[python]": {
                "editor.defaultFormatter": "ms-python.vscode-black-formatter"
              },
              "black-formatter.path": "{path}"
            }
          },
          {
            "executables": ["autopep8"],
            "vscodeExtension": "ms-python.autopep8",
            "settings": {
              "[python]": {
                "editor.defaultFormatter": "ms-python.autopep8"
              },
              "autopep8.path": "{path}"
            }
          },
          {
            "executables": ["yapf"],
            "vscodeExtension": "eeyore.yapf",
            "settings": {
              "[python]": {
                "editor.defaultFormatter": "eeyore.yapf"
              },
              "yapf.path": "{path}"
            }
          }
        ],
        "linter": [
          {
            "executables": ["ruff"],
            "vscodeExtension": "charliermarsh.ruff",
            "settings": {
              "ruff.enable": true,
              "ruff.path": ["{path}"]
            }
          },
          {
            "executables": ["flake8"],
            "vscodeExtension": "ms-python.flake8",
            "settings": {
              "flake8.path": "{path}"
            }
          },
          {
            "executables": ["pylint"],
            "vscodeExtension": "ms-python.pylint",
            "settings": {
              "pylint.path": "{path}"
            }
          },
          {
            "executables": ["mypy"],
            "vscodeExtension": "ms-python.mypy-type-checker",
            "settings": {
              "mypy-type-checker.path": "{path}"
            }
          }
        ],
        "compiler": [
          {
            "executables": ["python3", "python"],
            "vscodeExtension": "ms-python.python",
            "settings": {
              "python.defaultInterpreterPath": "{path}"
            }
          }
        ]
      }
    },

    "javascript_typescript": {
      "extensions": [".js", ".jsx", ".ts", ".tsx", ".mjs", ".cjs"],
      "filetypes": ["javascript", "typescript", "javascriptreact", "typescriptreact"],
      "languageId": ["javascript", "typescript"],
      "tools": {
        "lsp": [
          {
            "executables": ["typescript-language-server", "ts-language-server"],
            "vscodeExtension": "ms-vscode.vscode-typescript-next",
            "settings": {
              "typescript.tsserver.path": "{path}"
            }
          },
          {
            "executables": ["vtsls"],
            "vscodeExtension": "yiontech.vtsls",
            "settings": {
              "vtsls.server.path": "{path}"
            }
          }
        ],
        "dap": [
          {
            "executables": ["node"],
            "vscodeExtension": "ms-vscode.js-debug",
            "adapter": "node",
            "launchConfig": {
              "name": "Node: Current File",
              "type": "node",
              "request": "launch",
              "program": "${file}",
              "console": "integratedTerminal"
            }
          }
        ],
        "formatter": [
          {
            "executables": ["prettier"],
            "vscodeExtension": "esbenp.prettier-vscode",
            "settings": {
              "editor.defaultFormatter": "esbenp.prettier-vscode",
              "prettier.prettierPath": "{path}"
            }
          },
          {
            "executables": ["biome", "biome-format"],
            "vscodeExtension": "biomejs.biome",
            "settings": {
              "editor.defaultFormatter": "biomejs.biome"
            }
          },
          {
            "executables": ["deno"],
            "vscodeExtension": "denoland.vscode-deno",
            "settings": {
              "deno.enable": true
            }
          }
        ],
        "linter": [
          {
            "executables": ["eslint", "eslint_d"],
            "vscodeExtension": "dbaeumer.vscode-eslint",
            "settings": {
              "eslint.enable": true
            }
          },
          {
            "executables": ["biome"],
            "vscodeExtension": "biomejs.biome",
            "settings": {}
          },
          {
            "executables": ["oxlint"],
            "vscodeExtension": "oxc.oxc-vscode",
            "settings": {}
          }
        ],
        "compiler": [
          {
            "executables": ["tsc", "typescript"],
            "vscodeExtension": "ms-vscode.vscode-typescript-next",
            "settings": {}
          },
          {
            "executables": ["node", "nodejs"],
            "vscodeExtension": "ms-vscode.node-extension-pack",
            "settings": {}
          },
          {
            "executables": ["deno"],
            "vscodeExtension": "denoland.vscode-deno",
            "settings": {}
          },
          {
            "executables": ["bun"],
            "vscodeExtension": "oven.bun-vscode",
            "settings": {}
          }
        ]
      }
    },

    "go": {
      "extensions": [".go"],
      "filetypes": ["go"],
      "languageId": ["go"],
      "tools": {
        "lsp": [
          {
            "executables": ["gopls"],
            "vscodeExtension": "golang.go",
            "settings": {
              "gopls.path": "{path}"
            }
          }
        ],
        "dap": [
          {
            "executables": ["dlv", "delve"],
            "vscodeExtension": "golang.go",
            "adapter": "go",
            "launchConfig": {
              "name": "Go: Launch Package",
              "type": "go",
              "request": "launch",
              "mode": "auto",
              "program": "${fileDirname}"
            }
          }
        ],
        "formatter": [
          {
            "executables": ["gofmt", "goimports"],
            "vscodeExtension": "golang.go",
            "settings": {}
          }
        ],
        "linter": [
          {
            "executables": ["golangci-lint", "revive", "staticcheck"],
            "vscodeExtension": "golang.go",
            "settings": {
              "go.lintTool": "{basename}"
            }
          }
        ],
        "compiler": [
          {
            "executables": ["go"],
            "vscodeExtension": "golang.go",
            "settings": {
              "go.gopath": "{env:GOPATH}"
            }
          }
        ]
      }
