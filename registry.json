    "c_cpp": {
      "extensions": [".c", ".cpp", ".cc", ".cxx", ".h", ".hpp", ".hh"],
      "filetypes": ["c", "cpp"],
      "languageId": "cpp",
      "tools": {
        "lsp": [
          {
